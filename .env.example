APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=mcp-server-auth-template

# --- Runtime process contract ---
# The production launcher is `python -m mcp_server_auth_template.entrypoints.serve`.
# MCP 2026-07-28 is stateless, so workers do not require sticky sessions.
MCP_SERVER_RUNTIME_HOST=0.0.0.0
MCP_SERVER_RUNTIME_PORT=8000
MCP_SERVER_RUNTIME_WORKERS=1
MCP_SERVER_RUNTIME_BACKLOG=2048
MCP_SERVER_RUNTIME_KEEP_ALIVE_SECONDS=5
MCP_SERVER_RUNTIME_GRACEFUL_SHUTDOWN_SECONDS=30

# --- OAuth 2.1 resource server (see docs/adr/0002-oauth21-resource-server.md) ---
MCP_SERVER_RESOURCE_SERVER_URL=https://mcp.example.invalid
# Logical permission names. In Entra mode the server qualifies these with
# MCP_SERVER_ENTRA_APPLICATION_ID_URI before publishing/enforcing them.
MCP_SERVER_REQUIRED_SCOPES=["mcp:tools:call"]
# The example MCP health tool demonstrates runtime step-up with mcp:tools:health.
# Configure that delegated/API scope in the authorization server, but keep it out of the initial
# baseline above so clients request it incrementally from the 403 challenge.
# The server advertises io.modelcontextprotocol/oauth-client-credentials. Generic OIDC machine
# clients use the scopes above. Entra app-only tokens instead carry application permissions in
# `roles`; define and enforce ToolPolicy.application_roles(...) for app-only tools.

# Streamable HTTP is stateless + JSON-response only in this template.
# The public resource URL's Host and same Origin are trusted automatically.
# Add reverse-proxy Host values or browser Origins only when deliberately required.
MCP_SERVER_TRANSPORT_MAX_REQUEST_BODY_BYTES=1048576
MCP_SERVER_TRANSPORT_MAX_HEADER_COUNT=64
MCP_SERVER_TRANSPORT_MAX_HEADER_BYTES=32768
MCP_SERVER_TRANSPORT_MAX_CONCURRENT_REQUESTS=64
MCP_SERVER_TRANSPORT_ALLOWED_HOSTS=[]
MCP_SERVER_TRANSPORT_ALLOWED_ORIGINS=[]

# Production default: OIDC discovery/JWKS require HTTPS and globally-routable DNS.
# Set true only for a deliberate localhost test topology.
MCP_SERVER_OIDC_ALLOW_INSECURE_LOOPBACK=false

# Option A: Microsoft Entra ID
MCP_SERVER_AUTH_PROVIDER=entra
MCP_SERVER_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# For v2 access tokens, aud is the API's Application (client) ID GUID.
MCP_SERVER_ENTRA_AUDIENCE=22222222-2222-2222-2222-222222222222
# "Expose an API" -> Application ID URI. Clients request:
# api://222.../mcp:tools:call and api://222.../mcp:tools:health, while Entra emits the short
# logical values in the access token's scp claim.
MCP_SERVER_ENTRA_APPLICATION_ID_URI=api://22222222-2222-2222-2222-222222222222

# Option B: generic OIDC authorization server (Auth0, Keycloak, WorkOS AuthKit, ...)
# MCP_SERVER_AUTH_PROVIDER=generic
# MCP_SERVER_GENERIC_ISSUER_URL=https://your-tenant.example-as.com
# MCP_SERVER_GENERIC_AUDIENCE=https://mcp.example.invalid
# JWKS is same-origin with the issuer by default. Add only explicitly trusted cross-origin hosts.
# MCP_SERVER_GENERIC_JWKS_ALLOWED_ORIGINS=["https://keys.example-as.com"]

# Optional vendor-neutral OpenTelemetry traces (see docs/LLM_OBSERVABILITY.md).
# Network-silent unless an endpoint is explicitly set. Requires `uv sync --extra observability`.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=mcp-server-auth-template
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.version=0.3.0

# Optional Langfuse tracing (opt-in; see docs/LLM_OBSERVABILITY.md).
# Leave unset to keep tracing disabled. Requires `uv sync --extra tracing`.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false
