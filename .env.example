APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=mcp-server-auth-template

# --- OAuth 2.1 resource server (see docs/adr/0002-oauth21-resource-server.md) ---
MCP_SERVER_RESOURCE_SERVER_URL=https://mcp.example.invalid
# Logical permission names. In Entra mode the server qualifies these with
# MCP_SERVER_ENTRA_APPLICATION_ID_URI before publishing/enforcing them.
MCP_SERVER_REQUIRED_SCOPES=["mcp:tools:call"]

# Option A: Microsoft Entra ID
MCP_SERVER_AUTH_PROVIDER=entra
MCP_SERVER_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# For v2 access tokens, aud is the API's Application (client) ID GUID.
MCP_SERVER_ENTRA_AUDIENCE=22222222-2222-2222-2222-222222222222
# "Expose an API" -> Application ID URI. Clients request:
# api://222.../mcp:tools:call, while Entra emits scp="mcp:tools:call".
MCP_SERVER_ENTRA_APPLICATION_ID_URI=api://22222222-2222-2222-2222-222222222222

# Option B: generic OIDC authorization server (Auth0, Keycloak, WorkOS AuthKit, ...)
# MCP_SERVER_AUTH_PROVIDER=generic
# MCP_SERVER_GENERIC_ISSUER_URL=https://your-tenant.example-as.com
# MCP_SERVER_GENERIC_AUDIENCE=https://mcp.example.invalid

# Optional vendor-neutral OpenTelemetry traces (see docs/LLM_OBSERVABILITY.md).
# Network-silent unless an endpoint is explicitly set. Requires `uv sync --extra observability`.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=mcp-server-auth-template
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.version=0.1.0

# Optional Langfuse tracing (opt-in; see docs/LLM_OBSERVABILITY.md).
# Leave unset to keep tracing disabled. Requires `uv sync --extra tracing`.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false
